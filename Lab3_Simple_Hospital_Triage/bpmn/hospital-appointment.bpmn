      <bpmndi:BPMNShape id="TriageGateway_di" bpmnElement="TriageGateway" isMarkerVisible="true">
        <dc:Bounds x="740" y="213" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="688" y="263" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UrgentAssessment_di" bpmnElement="UrgentAssessment">
        <dc:Bounds x="880" y="45" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PriorityReview_di" bpmnElement="PriorityReview">
        <dc:Bounds x="880" y="390" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckAvailability_di" bpmnElement="CheckAvailability">
        <dc:Bounds x="880" y="198" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AvailabilityGateway_di" bpmnElement="AvailabilityGateway" isMarkerVisible="true">
        <dc:Bounds x="1120" y="213" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1115" y="175.5" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordBooking_di" bpmnElement="RecordBooking">
        <dc:Bounds x="1250" y="198" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookedEnd_di" bpmnElement="BookedEnd">
        <dc:Bounds x="1500" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1487" y="256" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NoSlotReview_di" bpmnElement="NoSlotReview">
        <dc:Bounds x="1235" y="300" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StaffEnd_di" bpmnElement="StaffEnd">
        <dc:Bounds x="1622" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1667.5" y="326" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
