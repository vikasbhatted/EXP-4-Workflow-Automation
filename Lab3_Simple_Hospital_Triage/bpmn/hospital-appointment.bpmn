      <bpmndi:BPMNShape id="RegistrationGateway_di" bpmnElement="RegistrationGateway" isMarkerVisible="true">
        <dc:Bounds x="430" y="213" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="175.5" width="59" height="27" />
