        <bpmndi:BPMNLabel>
          <dc:Bounds x="513" y="363" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5" bpmnElement="f5">
        <di:waypoint x="680" y="388" />
        <di:waypoint x="730" y="388" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e6" bpmnElement="f6">
        <di:waypoint x="780" y="388" />
        <di:waypoint x="830" y="388" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="783" y="363" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e7" bpmnElement="f7">
        <di:waypoint x="755" y="413" />
        <di:waypoint x="755" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="773" y="452" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e8" bpmnElement="f8">
        <di:waypoint x="1000" y="388" />
        <di:waypoint x="1050" y="388" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e9" bpmnElement="f9">
        <di:waypoint x="1075" y="363" />
        <di:waypoint x="1075" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1014" y="238" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e10" bpmnElement="f10">
        <di:waypoint x="1100" y="388" />
        <di:waypoint x="1170" y="388" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1111" y="363" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e11" bpmnElement="f11">
        <di:waypoint x="1160" y="120" />
        <di:waypoint x="1255" y="120" />
        <di:waypoint x="1255" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e12" bpmnElement="f12">
        <di:waypoint x="1255" y="255" />
        <di:waypoint x="1255" y="358" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1256" y="303" width="48" height="14" />
