        <di:waypoint x="1660" y="388" />
        <di:waypoint x="1710" y="388" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
